{
  "shadcnCli": "shadcn@3",
  "tailwindVersion": "v3",
  "registryNamespace": "@cloudai",
  "registryItemUrl": "https://o.alicdn.com/cloudai/cloudai/v3/r/default/{name}.json",
  "tailwindPkg": "@cloudai-design/tailwind",
  "defaultBrand": "aidbs",
  "brands": {
    "aidbs": {
      "tailwindPlugin": "@cloudai-design/tailwind/v3/aidbs",
      "iconLibrary": "lucide",
      "iconPackage": "lucide-react",
      "hasDarkMode": true,
      "tokensFile": "themes/aidbs-tokens.md"
    },
    "yaochi": {
      "tailwindPlugin": "@cloudai-design/tailwind/v3/yaochi",
      "iconLibrary": "lucide",
      "iconPackage": "lucide-react",
      "hasDarkMode": false,
      "tokensFile": "themes/yaochi-tokens.md"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@radix-ui/react-popover": "^1.1.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.34.0"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.8.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "tailwindcss-animate": "^1.0.7",
    "@cloudai-design/tailwind": "^0.2.3"
  }
}
